# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nexa"

# OAuth - GitHub
GITHUB_ID=""
GITHUB_SECRET=""

# OAuth - Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# NextAuth
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Supabase (Optional - for realtime, storage, auth)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Required for file uploads (/api/upload) to use Supabase Storage instead of local disk.
# Get from Supabase project Settings -> API -> service_role key. Server-side only, never expose to client.
SUPABASE_SERVICE_ROLE_KEY=""

# File Storage (fallback when Supabase Storage isn't configured — dev/self-hosted only,
# not persistent on Vercel's serverless filesystem)
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=10485760

# API
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
