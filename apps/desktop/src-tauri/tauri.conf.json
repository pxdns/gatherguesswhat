{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vertex",
  "version": "0.1.0",
  "identifier": "com.vertex.app",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "https://vertex-app.vercel.app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vertex",
        "url": "/",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
